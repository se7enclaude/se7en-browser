{
  "name": "se7en-browser",
  "productName": "se7en Browser",
  "version": "1.9.0",
  "description": "se7en Browser : un navigateur Liquid Glass avec IA locale (Ollama).",
  "main": "out/main/index.js",
  "private": true,
  "author": "se7en",
  "scripts": {
    "postinstall": "node tools/copier-pdfjs.mjs",
    "predev": "node tools/copier-pdfjs.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node tools/copier-pdfjs.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "icons": "python tools/make_icons.py",
    "dist": "node tools/build.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  }
}
